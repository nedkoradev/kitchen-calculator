rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid){return request.auth != null && request.auth.uid == uid;}
  function memberPath(uid,actor){return /databases/$(database)/documents/users/$(uid)/members/$(actor);}
  function invitePath(uid,id){return /databases/$(database)/documents/users/$(uid)/access_invites/$(id);}
  function google(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function canRead(uid){return owner(uid) || (request.auth != null && get(memberPath(uid,request.auth.uid)).data.status == 'active' && get(memberPath(uid,request.auth.uid)).data.role in ['editor','viewer']);}
  function canEdit(uid){return owner(uid) || (request.auth != null && get(memberPath(uid,request.auth.uid)).data.status == 'active' && get(memberPath(uid,request.auth.uid)).data.role == 'editor');}
  function accepts(uid,actor,d){
   let invitation=get(invitePath(uid,d.inviteId)).data;
   let accepted=getAfter(invitePath(uid,d.inviteId)).data;
   return google() && request.auth.uid == actor && actor != uid
    && d.keys().hasOnly(['uid','ownerUid','email','role','status','inviteId'])
    && d.uid == actor && d.ownerUid == uid && d.status == 'active'
    && d.role in ['editor','viewer'] && d.role == invitation.role && d.email == invitation.email
    && invitation.ownerUid == uid && invitation.state == 'pending' && invitation.expiresAt > request.time
    && invitation.email == request.auth.token.email.lower()
    && accepted.state == 'accepted' && accepted.acceptedBy == actor && accepted.acceptedAt == request.time;
  }
  match /users/{uid}/members/{actor} {
   allow get: if owner(uid) || (request.auth != null && request.auth.uid == actor);
   allow list: if owner(uid);
   allow create: if accepts(uid,actor,request.resource.data);
   allow update: if (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
    && request.resource.data.role in ['editor','viewer'] && request.resource.data.status in ['active','revoked'])
    || (resource.data.status == 'revoked' && accepts(uid,actor,request.resource.data));
   allow delete: if owner(uid);
  }
  match /users/{uid}/access_invites/{id} {
   allow get: if owner(uid) || (google() && resource.data.email == request.auth.token.email.lower());
   allow list: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['ownerUid','email','role','state','createdAt','expiresAt'])
    && request.resource.data.ownerUid == uid && request.resource.data.email is string
    && request.resource.data.email.matches('[^ /@]+@[^ /@]+') && request.resource.data.email == request.resource.data.email.lower()
    && request.resource.data.role in ['editor','viewer'] && request.resource.data.state == 'pending'
    && request.resource.data.createdAt == request.time && request.resource.data.expiresAt > request.time
    && request.resource.data.expiresAt <= request.time + duration.value(8,'d');
   allow update: if google() && resource.data.state == 'pending' && resource.data.expiresAt > request.time
    && resource.data.email == request.auth.token.email.lower()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','acceptedBy','acceptedAt'])
    && request.resource.data.state == 'accepted' && request.resource.data.acceptedBy == request.auth.uid
    && request.resource.data.acceptedAt == request.time
    && getAfter(memberPath(uid,request.auth.uid)).data.inviteId == id
    && getAfter(memberPath(uid,request.auth.uid)).data.status == 'active';
   allow delete: if owner(uid);
  }
  match /users/{actor}/shared_bases/{uid} {
   allow read: if request.auth != null && request.auth.uid == actor;
   allow create,update: if request.auth != null && request.auth.uid == actor
    && request.resource.data.keys().hasOnly(['ownerUid','joinedAt']) && request.resource.data.ownerUid == uid
    && request.resource.data.joinedAt == request.time && getAfter(memberPath(uid,actor)).data.status == 'active';
   allow delete: if (request.auth != null && request.auth.uid == actor)
    || (owner(uid) && getAfter(memberPath(uid,actor)).data.status == 'revoked');
  }
  // Original owner paths remain unchanged; membership gates shared working data.
  match /users/{uid}/v2_cabinets/{id} {
   allow read: if canRead(uid);
   allow write: if canEdit(uid);
  }
  match /users/{uid}/materials/{id} {
   allow read: if canRead(uid);
   allow write: if canEdit(uid);
  }
  function projectPath(uid,id){return /databases/$(database)/documents/users/$(uid)/v2_projects/$(id);}
  function claimPath(uid,key){return /databases/$(database)/documents/users/$(uid)/v2_project_names/$(key);}
  // Rules lower() folds ASCII only; explicitly fold the Bulgarian alphabet too.
  function nameKey(name){
   return name.lower().replace('А','а').replace('Б','б').replace('В','в').replace('Г','г').replace('Д','д').replace('Е','е').replace('Ж','ж').replace('З','з').replace('И','и').replace('Й','й').replace('К','к').replace('Л','л').replace('М','м').replace('Н','н').replace('О','о').replace('П','п').replace('Р','р').replace('С','с').replace('Т','т').replace('У','у').replace('Ф','ф').replace('Х','х').replace('Ц','ц').replace('Ч','ч').replace('Ш','ш').replace('Щ','щ').replace('Ъ','ъ').replace('Ь','ь').replace('Ю','ю').replace('Я','я').replace('Ѝ','ѝ');
  }
  function projectShape(d){
   return d.keys().hasOnly(['schemaVersion','name','nameKey','data','revision','createdAt','updatedAt'])
    && d.schemaVersion == 1 && d.name is string && d.name.size() > 0 && d.name.size() <= 100
    && d.name == d.name.trim() && !d.name.matches('.*[/\\x00-\\x1F\\x7F].*') && !d.name.matches('.*  .*')
    && d.nameKey == nameKey(d.name) && d.nameKey != '.' && d.nameKey != '..' && !d.nameKey.matches('__.*__')
    && d.data is map && d.data.parts is list && d.data.room is map
    && d.revision is int && d.revision > 0 && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function claimed(uid,id,d){
   return getAfter(claimPath(uid,d.nameKey)).data.projectId == id
    && getAfter(claimPath(uid,d.nameKey)).data.nameKey == d.nameKey;
  }
  match /users/{uid}/v2_projects/{id} {
   allow read: if canRead(uid);
   allow create: if canEdit(uid) && projectShape(request.resource.data)
    && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
    && claimed(uid,id,request.resource.data);
   allow update: if canEdit(uid) && projectShape(request.resource.data)
    && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.createdAt == resource.data.createdAt
    && claimed(uid,id,request.resource.data)
    && (resource.data.nameKey == request.resource.data.nameKey || !existsAfter(claimPath(uid,resource.data.nameKey)));
   allow delete: if canEdit(uid) && !existsAfter(claimPath(uid,resource.data.nameKey));
  }
  match /users/{uid}/v2_project_names/{key} {
   allow read: if canRead(uid);
   function validClaim(){
    return request.resource.data.keys().hasOnly(['nameKey','projectId'])
     && request.resource.data.nameKey == key && request.resource.data.projectId is string
     && request.resource.data.projectId.matches('[A-Za-z0-9_-]{1,128}')
     && getAfter(projectPath(uid,request.resource.data.projectId)).data.nameKey == key;
   }
   allow create: if canEdit(uid) && validClaim();
   allow update: if canEdit(uid) && validClaim() && request.resource.data.projectId == resource.data.projectId;
   allow delete: if canEdit(uid) && (!existsAfter(projectPath(uid,resource.data.projectId))
    || getAfter(projectPath(uid,resource.data.projectId)).data.nameKey != key);
  }
  // This does not override other allows; keep the matches above narrowly scoped.
  match /{document=**} {
   allow read, write: if false;
  }

 }
}
