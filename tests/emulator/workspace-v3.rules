rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function v3SignedIn() { return request.auth != null; }
    function v3Actor() { return request.auth.uid; }
    function v3CanRead(owner) {
      return v3SignedIn() && (v3Actor() == owner ||
        get(/databases/$(database)/documents/workspace_v3/$(owner)/grants/$(v3Actor())).data.role in ['editor', 'viewer']);
    }
    match /workspace_v3/{owner} {
      match /documents/{id} { allow read: if v3CanRead(owner); }
      match /settings/folders { allow get: if v3CanRead(owner); }
      match /grants/{actor} { allow get: if v3SignedIn() && (v3Actor() == owner || v3Actor() == actor); }
      match /pending/{actor} { allow get: if v3SignedIn() && v3Actor() == actor; }
      match /actors/{actor}/operations/{id} { allow get: if v3SignedIn() && v3Actor() == actor; }
      // All writes go through the authenticated server transaction service.
    }
  }
}
