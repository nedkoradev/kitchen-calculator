rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/access_invites/{id} {
   allow list: if request.auth != null && request.auth.uid == uid;
  }
  match /users/{actor}/shared_bases/{uid} {
   allow read: if request.auth != null && request.auth.uid == actor;
  }
 }
}
